@prefix mw: <https://raw.githubusercontent.com/Tesent/TIES4520_semi_final/main/muscle_wiki.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

mw:Barbell a mw:Equipment ;
    mw:Weight "60" ;
    mw:hasName "Barbell" .

mw:Dumbbell a mw:Equipment ;
    mw:Weight "20" ;
    mw:hasName "Dumbbell" .

mw:Pull_Up_Bar a mw:Equipment ;
    mw:hasName "Pull-Up Bar" .

mw:Lats a mw:Muscles ;
    mw:hasName "Latissimus Dorsi" ;
    rdfs:comment "A large back muscle targeted in pulling exercises." .

mw:Chest a mw:Muscles ;
    mw:hasName "Chest" ;
    rdfs:comment "A large muscle group in the front of the torso, targeted in pushing exercises." .

mw:Novice a mw:Difficulty ;
    mw:hasName "Novice Difficulty Level" ;
    rdfs:comment "Suitable for beginners with little or no experience." ;
    mw:Difficulty "Novice" .

mw:Advanced a mw:Difficulty ;
    mw:hasName "Advanced Difficulty Level" ;
    rdfs:comment "Suitable for individuals with high training experience." ;
    mw:Difficulty "Advanced" .


mw:Barbell_Bench_Press a mw:Exercise;
    mw:hasEquipment mw:Barbell ;
    mw:Repetitions "12" ;
    mw:Weight "60" ;
    mw:hasDifficulty mw:Advanced ;
    mw:hasMuscle mw:Chest ;
    mw:hasName "Barbell Bench Press" .

mw:Dumbbell_Incline_Bench_Press a mw:Exercise ;
    mw:hasMuscle mw:Chest ;
    mw:Repetitions "12" ;
    mw:Weight "20" ;
    mw:hasEquipment mw:Dumbbell ;
    mw:hasDifficulty mw:Advanced ;
    mw:hasName "Dumbbell Incline Bench Press" .

mw:Push_Up a mw:Exercise ;
    mw:Repetitions "12" ;
    mw:hasMuscle mw:Chest ;
    mw:hasDifficulty mw:Novice ;
    mw:hasName "Push Up" .

mw:Pull_Up a mw:Exercise ;
    rdfs:label "Pull-Up" ;
    rdfs:comment "A bodyweight exercise targeting the back muscles" ;
    mw:hasMuscle mw:Lats ;
    mw:hasDifficulty mw:Advanced ;
    mw:Repetitions "8" ;
    mw:hasEquipment mw:Pull_Up_Bar ;
    mw:hasName "Pull Up" .
